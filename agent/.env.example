# Copy to .env.local and fill in. .env.local is git-ignored.

# LiveKit project (cloud.livekit.io -> Settings -> API keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres. From inside Docker, the host machine is host.docker.internal.
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:54329/bytevoice
# Hosted Postgres only: the provider's CA certificate (PEM). TLS verification stays on.
# DATABASE_CA_CERT=

# Optional: swap a speech or language model without a rebuild. Defaults shown.
# STT_MODEL=deepgram/nova-3
# STT_LANGUAGE=bn
# LLM_MODEL=google/gemini-3.8-flash
# TTS_MODEL=google/gemini-3.8-flash-tts
# TTS_VOICE=Leda
