# Connect to your own agent with one of the following. Leave both blank to connect to the
# LiveKit homepage agent.

# Development token server ID from your project's Settings page in LiveKit Cloud.
# https://docs.livekit.io/frontends/build/authentication/development-token-server/
LIVEKIT_TOKEN_SERVER_ID=

# Otherwise use LiveKit credentials for the included token endpoint (app/api/token/route.ts).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Staff portal (/portal). Postgres connection string; the portal only reads.
# A local host connects without TLS. Any other host uses verified TLS; if its
# certificate is signed by a private CA (Supabase), paste that CA certificate
# into DATABASE_CA_CERT instead of turning verification off.
DATABASE_URL=postgres://postgres:password@localhost:5432/bytevoice
DATABASE_CA_CERT=

# Reviewer login for the portal, and the secret that signs the session cookie.
# Generate the secret with: openssl rand -base64 32
PORTAL_USER=reviewer
PORTAL_PASSWORD=change-me
PORTAL_SESSION_SECRET=replace-with-a-long-random-string
