# LiveKit project credentials, used only by the server route app/api/token/route.ts
# to sign short-lived call tokens. Never expose these to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Name the voice agent registers with (agent/). The token route dispatches it.
AGENT_NAME=bytevoice-bangla

# Staff portal (/portal). Postgres connection string; the portal only reads.
# A local host connects without TLS. Any other host uses verified TLS; if its
# certificate is signed by a private CA (Supabase), paste that CA certificate
# into DATABASE_CA_CERT instead of turning verification off.
DATABASE_URL=postgres://postgres:password@localhost:5432/bytevoice
DATABASE_CA_CERT=

# Reviewer login for the portal, and the secret that signs the session cookie.
# Generate the secret with: openssl rand -base64 32
PORTAL_USER=reviewer
PORTAL_PASSWORD=change-me
PORTAL_SESSION_SECRET=replace-with-a-long-random-string
